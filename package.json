{
  "name": "project-careers.lk",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "build:packages": "tsdown",
    "dev:packages": "tsdown --watch",
    "dev:api": "pnpm --filter backend dev",
    "dev:web": "pnpm --filter frontend dev",
    "dev": "pnpm --parallel --filter backend --filter frontend run dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "tsdown": "^0.22.4",
    "typescript-eslint": "^8.67.0"
  },
  "lint-staged": {
    "apps/web/**/*.{js,jsx,mjs,cjs,ts,tsx}": [
      "eslint --fix --config apps/web/eslint.config.mjs",
      "prettier --write"
    ],
    "apps/api/**/*.{js,jsx,mjs,cjs,ts,tsx}": [
      "eslint --fix --config apps/api/eslint.config.mjs",
      "prettier --write"
    ],
    "{apps/scrapper,packages}/**/*.{js,jsx,mjs,cjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/!(*.{js,jsx,mjs,cjs,ts,tsx})": "prettier --write --ignore-unknown"
  }
}

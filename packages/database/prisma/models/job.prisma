enum WorkMode {
  HYBRID
  REMOTE
  ONSITE
}

enum JobStatus {
  ACTIVE
  EXPIRED
}

enum JobSource {
  SCRAPED
  POSTED
}

enum JobApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Job {
  id              Int         @id @default(autoincrement())
  companyId       Int
  company         Company     @relation(fields: [companyId], references: [id])
  fingerprint     String      @unique
  title           String
  location        String?
  province        String?
  district        String?
  city            String?
  workMode        String?
  employmentType  String?
  sector          String?
  roleCategory    String?
  salaryMin       Int?
  salaryMax       Int?
  salaryCurrency  String?
  salaryPeriod    String?
  salaryRaw       String?
  description     String?
  imageUrl        String?
  deadline        DateTime?
  applyUrl        String?
  cvEmail         String?
  walkIn          Boolean     @default(false)
  status          JobStatus   @default(ACTIVE)
  lastSeenAt      DateTime
  deletedAt       DateTime?
  // Withdrawn (deletedAt set) jobs still show in the poster's own "My job
  // postings" list until they explicitly delete it — this flags that.
  profileHiddenAt DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  batchId         String?
  batch           AiBatchLog? @relation(fields: [batchId], references: [id])

  source            JobSource         @default(SCRAPED)
  postedByWebUserId Int?
  postedBy          WebUser?          @relation(fields: [postedByWebUserId], references: [id])
  approvalStatus    JobApprovalStatus @default(APPROVED)
  approvedByAdminId Int?
  approvedByAdmin   AdminUser?        @relation(fields: [approvedByAdminId], references: [id])
  approvedAt        DateTime?
  rejectionReason   String?

  skills   JobSkill[]
  keywords JobKeyword[]

  slug          String       @unique
  seoRoleId     Int?
  seoRole       SeoRole?     @relation(fields: [seoRoleId], references: [id])
  seoLocationId Int?
  seoLocation   SeoLocation? @relation(fields: [seoLocationId], references: [id])

  savedBy SavedJob[]

  @@index([companyId])
  @@index([status])
  @@index([fingerprint])
  @@index([sector])
  @@index([slug])
  @@index([seoRoleId])
  @@index([seoLocationId])
  @@index([approvalStatus])
  @@index([postedByWebUserId])
  @@index([province])
  @@index([district])
  @@index([city])
}

enum SkillType {
  EXPLICIT
  INFERRED
}

model JobSkill {
  id    Int       @id @default(autoincrement())
  jobId Int
  job   Job       @relation(fields: [jobId], references: [id])
  name  String
  type  SkillType

  seoSkillId Int?
  seoSkill   SeoSkill? @relation(fields: [seoSkillId], references: [id])

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([jobId])
  @@index([seoSkillId])
}

model Keyword {
  id   Int    @id @default(autoincrement())
  name String @unique

  jobs JobKeyword[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JobKeyword {
  jobId         Int
  job           Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  keywordId     Int
  keyword       Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  editedByAdmin Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([jobId, keywordId])
  @@index([jobId])
  @@index([keywordId])
}

model SavedJob {
  id        Int      @id @default(autoincrement())
  webUserId Int
  webUser   WebUser  @relation(fields: [webUserId], references: [id], onDelete: Cascade)
  jobId     Int
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([webUserId, jobId])
  @@index([webUserId])
  @@index([jobId])
  @@map("saved_jobs")
}

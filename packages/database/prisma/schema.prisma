// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
}

enum ScrapeStatus {
  ACTIVE
  EMPTY
  ERROR
  CHECK
  SKIPPED
}

enum WorkMode {
  HYBRID
  REMOTE
  ONSITE
}

// CHECK -> suspected failure

model User {
  id               Int       @id @default(autoincrement())
  email            String    @unique
  username         String    @unique
  password         String
  firstName        String
  lastName         String
  role             UserRole  @default(ADMIN)
  isActive         Boolean   @default(true)
  refreshTokenHash String?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastLoginAt      DateTime  @default(now())

  createdById  Int?
  createdBy    User?      @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers User[]     @relation("UserCreatedBy")
  auditLogs    AuditLog[]

  @@index([email])
}

enum JobStatus {
  ACTIVE
  EXPIRED
}

// scrape status not needed?
model Company {
  id                     Int          @id @default(autoincrement())
  name                   String
  logoUrl                String?
  websiteUrl             String
  careerUrl              String
  atsPlatform            String?
  pageHash               String?
  lastScrapedAt          DateTime?
  scrapeStatus           ScrapeStatus @default(EMPTY)
  htmlSelector           String?
  htmlSelectorType       String?
  htmlSelectorReason     String?
  htmlSelectorConfidence String?
  paginationType         String?
  paginationBtn          String?
  paginationReason       String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  jobs            Job[]
  scrapeLogs      ScrapeLog[]
  claudeLogs      ClaudeLog[]
  claudeBatchLogs ClaudeBatchLog[]
}

model Job {
  id             Int             @id @default(autoincrement())
  companyId      Int
  company        Company         @relation(fields: [companyId], references: [id])
  fingerprint    String          @unique
  title          String
  location       String?
  workMode       String?
  employmentType String?
  roleCategory   String?
  department     String?
  salaryMin      Int?
  salaryMax      Int?
  salaryCurrency String?
  salaryRaw      String?
  description    String?
  deadline       DateTime?
  applyUrl       String?
  status         JobStatus       @default(ACTIVE)
  lastSeenAt     DateTime
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  batchId        String?
  batch          ClaudeBatchLog? @relation(fields: [batchId], references: [id])

  skills   JobSkill[]
  keywords JobKeyword[]

  @@index([companyId])
  @@index([status])
  @@index([fingerprint])
}

enum SkillType {
  EXPLICIT
  INFERRED
}

model JobSkill {
  id    Int       @id @default(autoincrement())
  jobId Int
  job   Job       @relation(fields: [jobId], references: [id])
  name  String
  type  SkillType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId])
}

model JobKeyword {
  id            Int     @id @default(autoincrement())
  jobId         Int
  job           Job     @relation(fields: [jobId], references: [id])
  keyword       String
  editedByAdmin Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId])
}

enum ScrapeLogTrigger {
  SCHEDULED
  MANUAL
}

enum ScrapeLogStatus {
  SUCCESS
  EMPTY
  SUSPECTED_FAILURE
  ERROR
}

model ScrapeLog {
  id           Int              @id @default(autoincrement())
  companyId    Int
  company      Company          @relation(fields: [companyId], references: [id])
  triggeredBy  ScrapeLogTrigger
  jobsFound    Int              @default(0)
  status       ScrapeLogStatus
  errorMessage String?
  durationMs   Int              @default(0)
  htmlLength   Int?
  type         String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  claudeLogs   ClaudeLog[]

  @@index([companyId])
  @@index([createdAt])
}

model ClaudeLog {
  id           String          @id
  companyId    Int
  company      Company         @relation(fields: [companyId], references: [id])
  scrapeLogId  Int
  scrapeLog    ScrapeLog       @relation(fields: [scrapeLogId], references: [id])
  batchId      String?
  batchLog     ClaudeBatchLog? @relation(fields: [batchId], references: [id])
  status       String
  stopReason   String?
  model        String?
  inputTokens  Int?
  outputTokens Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([createdAt])
}

model ClaudeBatchLog {
  id         String      @id
  status     String
  response   Json
  type       String
  claudeLogs ClaudeLog[]
  jobs       Job[]
  companies  Company[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model AlertSubscription {
  id        Int      @id @default(autoincrement())
  email     String
  criteria  Json
  confirmed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  userRole   UserRole
  action     String
  entityType String
  entityId   String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String
  userAgent  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

enum PackageType {
  ADSENSE
  MODAL
  SPONSORED_CARD
}

enum InvoiceStatus {
  PENDING
  SENT
  PAID
  OVERDUE
}

model Advertiser {
  id             Int           @id @default(autoincrement())
  name           String
  contactEmail   String
  packageType    PackageType
  slotPosition   Int?
  creativeUrl    String?
  headline       String?
  description    String?
  ctaText        String?
  destinationUrl String?
  startDate      DateTime
  endDate        DateTime
  invoiceStatus  InvoiceStatus @default(PENDING)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([isActive])
  @@index([startDate, endDate])
}

enum SeoPageType {
  ROLE
  LOCATION
  ROLE_LOCATION
  COMPANY
  SKILL
  REMOTE
  INTERNSHIP
}

model SeoPage {
  id               Int         @id @default(autoincrement())
  pageType         SeoPageType
  slug             String      @unique
  roleId           String?
  locationId       String?
  companyId        String?
  skillId          String?
  title            String
  metaDescription  String
  h1               String
  introText        String
  bottomText       String
  canonicalUrl     String
  relatedLinksJson Json
  isIndexable      Boolean
  contentVersion   Int         @default(1)
  lastGeneratedAt  DateTime
  lastReviewedAt   DateTime?
  manualOverride   Boolean     @default(false)
  lastmod          DateTime
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([pageType])
  @@index([slug])
}

model SeoRole {
  id   Int    @id @default(autoincrement())
  name String
  slug String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SeoLocation {
  id      Int    @id @default(autoincrement())
  name    String
  slug    String @unique
  country String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SeoSkill {
  id   Int    @id @default(autoincrement())
  name String
  slug String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

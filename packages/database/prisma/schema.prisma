// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ScrapeStatus {
  ACTIVE
  EMPTY
  ERROR
  CHECK
  SKIPPED
}

enum WorkMode {
  HYBRID
  REMOTE
  ONSITE
}

// CHECK -> suspected failure

model AdminUser {
  id               Int       @id @default(autoincrement())
  email            String    @unique
  password         String
  firstName        String
  lastName         String
  isActive         Boolean   @default(true)
  refreshTokenHash String?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastLoginAt      DateTime  @default(now())

  createdById  Int?
  createdBy    AdminUser?  @relation("AdminUserCreatedBy", fields: [createdById], references: [id])
  createdUsers AdminUser[] @relation("AdminUserCreatedBy")
  auditLogs    AuditLog[]

  roleAssignments RoleAssignment[]

  approvedJobs          Job[]
  reviewedCompanyClaims CompanyClaim[]

  approvedFreelanceProfiles FreelanceProfile[] @relation("FreelanceProfileApprovedBy")
  approvedGigs              Gig[]              @relation("GigApprovedBy")

  reviewedAbuseReports AbuseReport[]

  @@index([email])
  @@map("admin_users")
}

model WebUser {
  id               Int       @id @default(autoincrement())
  email            String    @unique
  googleId         String?   @unique
  firstName        String?
  lastName         String?
  avatarUrl        String?
  isActive         Boolean   @default(true)
  refreshTokenHash String?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastLoginAt      DateTime  @default(now())

  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])

  createdCompanies Company[]      @relation("CompanyCreatedByWebUser")
  postedJobs       Job[]
  savedJobs        SavedJob[]
  companyClaims    CompanyClaim[]

  freelanceProfile FreelanceProfile?
  postedGigs       Gig[]             @relation("GigPostedBy")

  sentChatMessages              ChatMessage[]  @relation("ChatMessageSender")
  conversationsAsParticipantOne Conversation[] @relation("ConversationParticipantOne")
  conversationsAsParticipantTwo Conversation[] @relation("ConversationParticipantTwo")
  blocksInitiated               WebUserBlock[] @relation("BlocksInitiated")
  blocksReceived                WebUserBlock[] @relation("BlocksReceived")
  abuseReportsFiled             AbuseReport[]

  @@index([email])
  @@index([googleId])
  @@index([companyId])
  @@map("web_users")
}

model WebUserEmailOtp {
  id            Int       @id @default(autoincrement())
  email         String
  codeHash      String
  expiresAt     DateTime
  attempts      Int       @default(0)
  consumedAt    DateTime?
  invalidatedAt DateTime?
  createdAt     DateTime  @default(now())

  @@index([email])
  @@map("web_user_email_otps")
}

model Role {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userAssignments       RoleAssignment[]
  permissionAssignments RolePermission[]

  @@index([slug])
}

model Permission {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roleAssignments RolePermission[]

  @@index([module])
}

model RoleAssignment {
  userId     Int
  roleId     Int
  assignedAt DateTime @default(now())

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

enum JobStatus {
  ACTIVE
  EXPIRED
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
}

enum CompanyAutoApprovalStatus {
  NONE
  REQUESTED
  GRANTED
  DENIED
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

// scrape status not needed?
model Company {
  id                     Int           @id @default(autoincrement())
  name                   String
  logoUrl                String?
  websiteUrl             String?       @unique
  careerUrl              String?
  atsPlatform            String?
  pageHash               String?
  lastScrapedAt          DateTime?
  status                 CompanyStatus @default(ACTIVE)
  scrapeStatus           ScrapeStatus  @default(EMPTY)
  htmlSelector           String?
  htmlSelectorType       String?
  htmlSelectorReason     String?
  htmlSelectorConfidence String?
  paginationType         String?
  paginationBtn          String?
  paginationReason       String?
  deletedAt              DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  description  String?
  linkedinUrl  String?
  twitterUrl   String?
  facebookUrl  String?
  instagramUrl String?

  createdByWebUserId Int?
  createdByWebUser   WebUser? @relation("CompanyCreatedByWebUser", fields: [createdByWebUserId], references: [id])

  autoApproveJobs         Boolean                   @default(false)
  autoApprovalStatus      CompanyAutoApprovalStatus @default(NONE)
  autoApprovalRequestedAt DateTime?

  jobs          Job[]
  scrapeLogs    ScrapeLog[]
  aiLogs        AiLog[]
  aiBatchLogs   AiBatchLog[]
  seoPages      SeoPage[]
  webUsers      WebUser[]
  companyClaims CompanyClaim[]

  slug String @unique

  @@index([createdByWebUserId])
}

model CompanyClaim {
  id        Int     @id @default(autoincrement())
  webUserId Int
  webUser   WebUser @relation(fields: [webUserId], references: [id])
  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  status ClaimStatus @default(PENDING)

  reviewedByAdminId Int?
  reviewedByAdmin   AdminUser? @relation(fields: [reviewedByAdminId], references: [id])
  reviewedAt        DateTime?

  createdAt DateTime @default(now())

  @@unique([webUserId, companyId])
  @@index([companyId, status])
  @@map("company_claims")
}

enum JobSource {
  SCRAPED
  POSTED
}

enum JobApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Job {
  id             Int         @id @default(autoincrement())
  companyId      Int
  company        Company     @relation(fields: [companyId], references: [id])
  fingerprint    String      @unique
  title          String
  location       String?
  province       String?
  district       String?
  city           String?
  workMode       String?
  employmentType String?
  sector         String?
  roleCategory   String?
  salaryMin      Int?
  salaryMax      Int?
  salaryCurrency String?
  salaryRaw      String?
  description    String?
  imageUrl       String?
  deadline       DateTime?
  applyUrl       String?
  status         JobStatus   @default(ACTIVE)
  lastSeenAt     DateTime
  deletedAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  batchId        String?
  batch          AiBatchLog? @relation(fields: [batchId], references: [id])

  source            JobSource         @default(SCRAPED)
  postedByWebUserId Int?
  postedBy          WebUser?          @relation(fields: [postedByWebUserId], references: [id])
  approvalStatus    JobApprovalStatus @default(APPROVED)
  approvedByAdminId Int?
  approvedByAdmin   AdminUser?        @relation(fields: [approvedByAdminId], references: [id])
  approvedAt        DateTime?
  rejectionReason   String?

  skills   JobSkill[]
  keywords JobKeyword[]

  slug          String       @unique
  seoRoleId     Int?
  seoRole       SeoRole?     @relation(fields: [seoRoleId], references: [id])
  seoLocationId Int?
  seoLocation   SeoLocation? @relation(fields: [seoLocationId], references: [id])

  savedBy SavedJob[]

  @@index([companyId])
  @@index([status])
  @@index([fingerprint])
  @@index([sector])
  @@index([slug])
  @@index([seoRoleId])
  @@index([seoLocationId])
  @@index([approvalStatus])
  @@index([postedByWebUserId])
  @@index([province])
  @@index([district])
  @@index([city])
}

enum SkillType {
  EXPLICIT
  INFERRED
}

model JobSkill {
  id    Int       @id @default(autoincrement())
  jobId Int
  job   Job       @relation(fields: [jobId], references: [id])
  name  String
  type  SkillType

  seoSkillId Int?
  seoSkill   SeoSkill? @relation(fields: [seoSkillId], references: [id])

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([jobId])
  @@index([seoSkillId])
}

model Keyword {
  id   Int    @id @default(autoincrement())
  name String @unique

  jobs JobKeyword[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JobKeyword {
  jobId         Int
  job           Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  keywordId     Int
  keyword       Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  editedByAdmin Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([jobId, keywordId])
  @@index([jobId])
  @@index([keywordId])
}

enum ScrapeLogTrigger {
  SCHEDULED
  MANUAL
}

enum ScrapeLogStatus {
  SUCCESS
  EMPTY
  SUSPECTED_FAILURE
  ERROR
}

model ScrapeLog {
  id           Int              @id @default(autoincrement())
  companyId    Int
  company      Company          @relation(fields: [companyId], references: [id])
  triggeredBy  ScrapeLogTrigger
  jobsFound    Int              @default(0)
  status       ScrapeLogStatus
  errorMessage String?
  durationMs   Int              @default(0)
  htmlLength   Int?
  type         String
  deletedAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  aiLogs       AiLog[]

  @@index([companyId])
  @@index([createdAt])
}

model AiLog {
  id           String      @id
  companyId    Int
  company      Company     @relation(fields: [companyId], references: [id])
  scrapeLogId  Int
  scrapeLog    ScrapeLog   @relation(fields: [scrapeLogId], references: [id])
  batchId      String?
  batchLog     AiBatchLog? @relation(fields: [batchId], references: [id])
  status       String
  stopReason   String?
  model        String?
  inputTokens  Int?
  outputTokens Int?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([companyId])
  @@index([createdAt])
}

model AiBatchLog {
  id        String    @id
  status    String
  response  Json
  type      String
  aiLogs    AiLog[]
  jobs      Job[]
  companies Company[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([createdAt])
}

model AlertSubscription {
  id        Int      @id @default(autoincrement())
  email     String
  criteria  Json
  confirmed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model AuditLog {
  id          Int        @id @default(autoincrement())
  actorUserId Int?
  actor       AdminUser? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorEmail  String?
  action      String
  entityType  String
  entityId    String?
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  userAgent   String?
  deletedAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

enum NotificationType {
  SCRAPE_COMPLETED
  SCRAPE_FAILED
}

model Notification {
  id        Int              @id @default(autoincrement())
  type      NotificationType
  title     String
  message   String
  metadata  Json?
  readAt    DateTime?
  deletedAt DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([readAt])
  @@index([createdAt])
}

enum PackageType {
  ADSENSE
  MODAL
  SPONSORED_CARD
}

enum InvoiceStatus {
  PENDING
  SENT
  PAID
  OVERDUE
}

model Advertiser {
  id             Int           @id @default(autoincrement())
  name           String
  contactEmail   String
  packageType    PackageType
  slotPosition   Int?
  creativeUrl    String?
  headline       String?
  description    String?
  ctaText        String?
  destinationUrl String?
  startDate      DateTime
  endDate        DateTime
  invoiceStatus  InvoiceStatus @default(PENDING)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([isActive])
  @@index([startDate, endDate])
}

enum SeoPageType {
  SECTOR
  ROLE
  LOCATION
  ROLE_LOCATION
  COMPANY
  SKILL
  REMOTE
  INTERNSHIP
  ALL_JOBS
}

model SeoPage {
  id               Int          @id @default(autoincrement())
  pageType         SeoPageType
  slug             String       @unique
  // Sector is a fixed, code-defined taxonomy key (SECTOR_TAXONOMY in
  // @careerslk/types), not noisy scraped free text like location/skill —
  // so unlike those, it's stored directly rather than via a lookup-table FK.
  sector           String?
  roleId           Int?
  role             SeoRole?     @relation(fields: [roleId], references: [id])
  locationId       Int?
  location         SeoLocation? @relation(fields: [locationId], references: [id])
  companyId        Int?
  company          Company?     @relation(fields: [companyId], references: [id])
  skillId          Int?
  skill            SeoSkill?    @relation(fields: [skillId], references: [id])
  title            String
  metaDescription  String
  h1               String
  introText        String
  bottomText       String
  faqJson          Json?
  canonicalUrl     String
  relatedLinksJson Json
  isIndexable      Boolean
  contentVersion   Int          @default(1)
  lastGeneratedAt  DateTime
  lastReviewedAt   DateTime?
  manualOverride   Boolean      @default(false)
  lastmod          DateTime

  jobCount              Int       @default(0)
  companyCount          Int       @default(0)
  firstBelowThresholdAt DateTime?
  deactivatedAt         DateTime?
  retiredAt             DateTime?
  needsReview           Boolean   @default(false)
  validationIssues      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pageType, roleId, locationId, companyId, skillId, sector])
  @@index([pageType])
  @@index([slug])
  @@index([roleId])
  @@index([locationId])
  @@index([companyId])
  @@index([skillId])
  @@index([sector])
}

model SeoRole {
  id   Int    @id @default(autoincrement())
  name String
  slug String @unique

  jobs     Job[]
  seoPages SeoPage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum LocationLevel {
  PROVINCE
  DISTRICT
  CITY
}

model SeoLocation {
  id      Int           @id @default(autoincrement())
  name    String
  slug    String        @unique
  country String
  level   LocationLevel

  parentId Int?
  parent   SeoLocation?  @relation("LocationHierarchy", fields: [parentId], references: [id])
  children SeoLocation[] @relation("LocationHierarchy")

  jobs     Job[]
  seoPages SeoPage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([level])
  @@index([parentId])
}

model SeoSkill {
  id   Int    @id @default(autoincrement())
  name String
  slug String @unique

  jobSkills JobSkill[]
  seoPages  SeoPage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum FreelanceApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model FreelanceProfile {
  id        Int     @id @default(autoincrement())
  webUserId Int     @unique
  webUser   WebUser @relation(fields: [webUserId], references: [id])

  bio               String?
  rate              Int?
  rateCurrency      String?
  category          String?
  skills            String[]
  portfolioLinks    String[]
  workHistory       Json?
  cvFileKey         String?
  portfolioFileKeys String[] @default([])

  approvalStatus      FreelanceApprovalStatus @default(PENDING)
  approvedByAdminId   Int?
  approvedByAdmin     AdminUser?              @relation("FreelanceProfileApprovedBy", fields: [approvedByAdminId], references: [id])
  approvedAt          DateTime?
  rejectionReason     String?
  internalReviewNotes String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  slug String @unique

  conversations Conversation[]

  @@index([approvalStatus])
  @@index([webUserId])
  @@index([category])
  @@map("freelance_profiles")
}

model Gig {
  id                Int     @id @default(autoincrement())
  postedByWebUserId Int
  postedBy          WebUser @relation("GigPostedBy", fields: [postedByWebUserId], references: [id])

  title              String
  description        String?
  category           String?
  skills             String[]
  budgetMin          Int?
  budgetMax          Int?
  budgetCurrency     String?
  deadline           DateTime?
  attachmentFileKeys String[]  @default([])

  approvalStatus      FreelanceApprovalStatus @default(PENDING)
  approvedByAdminId   Int?
  approvedByAdmin     AdminUser?              @relation("GigApprovedBy", fields: [approvedByAdminId], references: [id])
  approvedAt          DateTime?
  rejectionReason     String?
  internalReviewNotes String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  slug String @unique

  conversations Conversation[]

  @@index([approvalStatus])
  @@index([postedByWebUserId])
  @@index([category])
  @@map("gigs")
}

enum AbuseReportEntityType {
  FREELANCE_PROFILE
  GIG
  CHAT_MESSAGE
  CHAT_THREAD
}

enum AbuseReportCategory {
  SPAM
  SCAM_FRAUD
  HARASSMENT
  INAPPROPRIATE_CONTENT
  OTHER
}

enum AbuseReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

model Conversation {
  id Int @id @default(autoincrement())

  // Ordered pair — participantOneId is always the smaller WebUser.id, so
  // (A,B) and (B,A) always collapse to the same row regardless of who
  // initiates. Ordering happens once, in the service layer, never trusted
  // from the client.
  participantOneId Int
  participantOne   WebUser @relation("ConversationParticipantOne", fields: [participantOneId], references: [id])
  participantTwoId Int
  participantTwo   WebUser @relation("ConversationParticipantTwo", fields: [participantTwoId], references: [id])

  // "Regarding" display context — set once at creation from whichever entry
  // point started the thread, never overwritten (one thread per pair).
  contextGigId              Int?
  contextGig                Gig?              @relation(fields: [contextGigId], references: [id])
  contextFreelanceProfileId Int?
  contextFreelanceProfile   FreelanceProfile? @relation(fields: [contextFreelanceProfileId], references: [id])

  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  messages ChatMessage[]

  @@unique([participantOneId, participantTwoId])
  @@index([participantOneId])
  @@index([participantTwoId])
  @@index([lastMessageAt])
  @@map("conversations")
}

model ChatMessage {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       Int
  sender         WebUser      @relation("ChatMessageSender", fields: [senderId], references: [id])
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

model WebUserBlock {
  id        Int      @id @default(autoincrement())
  blockerId Int
  blocker   WebUser  @relation("BlocksInitiated", fields: [blockerId], references: [id])
  blockedId Int
  blocked   WebUser  @relation("BlocksReceived", fields: [blockedId], references: [id])
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("web_user_blocks")
}

model AbuseReport {
  id                Int     @id @default(autoincrement())
  reporterWebUserId Int
  reporter          WebUser @relation(fields: [reporterWebUserId], references: [id])

  entityType      AbuseReportEntityType
  entityId        Int
  category        AbuseReportCategory
  details         String?
  // Snapshot of the reported content at filing time (profile bio, gig
  // title+description, or chat message body) — the admin queue never needs
  // a per-entity-type join, and the snapshot survives the source being
  // later edited or soft-deleted.
  contentSnapshot String

  status            AbuseReportStatus @default(PENDING)
  reviewedByAdminId Int?
  reviewedByAdmin   AdminUser?        @relation(fields: [reviewedByAdminId], references: [id])
  reviewedAt        DateTime?
  resolutionNotes   String?

  createdAt DateTime @default(now())

  @@index([status])
  @@index([entityType, entityId])
  @@index([reporterWebUserId])
  @@map("abuse_reports")
}

model SavedJob {
  id        Int      @id @default(autoincrement())
  webUserId Int
  webUser   WebUser  @relation(fields: [webUserId], references: [id], onDelete: Cascade)
  jobId     Int
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([webUserId, jobId])
  @@index([webUserId])
  @@index([jobId])
  @@map("saved_jobs")
}

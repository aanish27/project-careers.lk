// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
}

enum ScrapeStatus {
  ACTIVE
  EMPTY
  ERROR
  CHECK
}

// CHECK -> suspected failure

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  username         String    @unique
  password         String
  firstName        String
  lastName         String
  role             UserRole  @default(ADMIN)
  isActive         Boolean   @default(true)
  refreshTokenHash String?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastLoginAt      DateTime  @default(now())

  createdById  String?
  createdBy    User?      @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers User[]     @relation("UserCreatedBy")
  auditLogs    AuditLog[]

  @@index([email])
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

enum JobStatus {
  ACTIVE
  EXPIRED
}

model Company {
  id            String       @id @default(uuid())
  careerUrl     String
  atsPlatform   String?
  pageHash      String?
  lastScrapedAt DateTime?
  scrapeStatus  ScrapeStatus @default(EMPTY)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs       Job[]
  scrapeLogs ScrapeLog[]
}

model Job {
  id             String         @id @default(uuid())
  companyId      String
  company        Company        @relation(fields: [companyId], references: [id])
  fingerprint    String         @unique
  title          String
  location       String?
  remote         Boolean        @default(false)
  employmentType EmploymentType
  salaryMin      Int?
  salaryMax      Int?
  salaryCurrency String?
  salaryRaw      String?
  description    String
  deadline       DateTime?
  applyUrl       String
  status         JobStatus      @default(ACTIVE)
  lastSeenAt     DateTime
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  skills   JobSkill[]
  keywords JobKeyword[]

  @@index([companyId])
  @@index([status])
  @@index([fingerprint])
}

enum SkillType {
  EXPLICIT
  INFERRED
}

model JobSkill {
  id    String    @id @default(uuid())
  jobId String
  job   Job       @relation(fields: [jobId], references: [id])
  name  String
  type  SkillType

  @@index([jobId])
}

model JobKeyword {
  id            String  @id @default(uuid())
  jobId         String
  job           Job     @relation(fields: [jobId], references: [id])
  keyword       String
  editedByAdmin Boolean @default(false)

  @@index([jobId])
}

enum ScrapeLogTrigger {
  SCHEDULED
  MANUAL
}

enum ScrapeLogStatus {
  SUCCESS
  EMPTY
  SUSPECTED_FAILURE
  ERROR
}

model ScrapeLog {
  id           String           @id @default(uuid())
  companyId    String
  company      Company          @relation(fields: [companyId], references: [id])
  triggeredBy  ScrapeLogTrigger
  jobsFound    Int
  status       ScrapeLogStatus
  errorMessage String?
  durationMs   Int
  createdAt    DateTime         @default(now())

  @@index([companyId])
  @@index([createdAt])
}

model AlertSubscription {
  id        String   @id @default(uuid())
  email     String
  criteria  Json
  confirmed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  userRole   UserRole
  action     String
  entityType String
  entityId   String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String
  userAgent  String
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

enum PackageType {
  ADSENSE
  MODAL
  SPONSORED_CARD
}

enum InvoiceStatus {
  PENDING
  SENT
  PAID
  OVERDUE
}

model Advertiser {
  id             String        @id @default(uuid())
  name           String
  contactEmail   String
  packageType    PackageType
  slotPosition   Int?
  creativeUrl    String?
  headline       String?
  description    String?
  ctaText        String?
  destinationUrl String?
  startDate      DateTime
  endDate        DateTime
  invoiceStatus  InvoiceStatus @default(PENDING)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())

  @@index([isActive])
  @@index([startDate, endDate])
}

enum SeoPageType {
  ROLE
  LOCATION
  ROLE_LOCATION
  COMPANY
  SKILL
  REMOTE
  INTERNSHIP
}

model SeoPage {
  id               String      @id @default(uuid())
  pageType         SeoPageType
  slug             String      @unique
  roleId           String?
  locationId       String?
  companyId        String?
  skillId          String?
  title            String
  metaDescription  String
  h1               String
  introText        String
  bottomText       String
  canonicalUrl     String
  relatedLinksJson Json
  isIndexable      Boolean
  contentVersion   Int         @default(1)
  lastGeneratedAt  DateTime
  lastReviewedAt   DateTime?
  manualOverride   Boolean     @default(false)
  lastmod          DateTime
  createdAt        DateTime    @default(now())

  @@index([pageType])
  @@index([slug])
}

model SeoRole {
  id   String @id @default(uuid())
  name String
  slug String @unique
}

model SeoLocation {
  id      String @id @default(uuid())
  name    String
  slug    String @unique
  country String
}

model SeoSkill {
  id   String @id @default(uuid())
  name String
  slug String @unique
}

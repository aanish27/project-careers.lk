// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ScrapeStatus {
  ACTIVE
  EMPTY
  ERROR
  CHECK
  SKIPPED
}

enum WorkMode {
  HYBRID
  REMOTE
  ONSITE
}

// CHECK -> suspected failure

model AdminUser {
  id               Int       @id @default(autoincrement())
  email            String    @unique
  password         String
  firstName        String
  lastName         String
  isActive         Boolean   @default(true)
  refreshTokenHash String?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastLoginAt      DateTime  @default(now())

  createdById  Int?
  createdBy    AdminUser?  @relation("AdminUserCreatedBy", fields: [createdById], references: [id])
  createdUsers AdminUser[] @relation("AdminUserCreatedBy")
  auditLogs    AuditLog[]

  roleAssignments RoleAssignment[]

  @@index([email])
  @@map("admin_users")
}

model Role {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userAssignments       RoleAssignment[]
  permissionAssignments RolePermission[]

  @@index([slug])
}

model Permission {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roleAssignments RolePermission[]

  @@index([module])
}

model RoleAssignment {
  userId     Int
  roleId     Int
  assignedAt DateTime @default(now())

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

enum JobStatus {
  ACTIVE
  EXPIRED
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
}

// scrape status not needed?
model Company {
  id                     Int           @id @default(autoincrement())
  name                   String
  logoUrl                String?
  websiteUrl             String        @unique
  careerUrl              String
  atsPlatform            String?
  pageHash               String?
  lastScrapedAt          DateTime?
  status                 CompanyStatus @default(ACTIVE)
  scrapeStatus           ScrapeStatus  @default(EMPTY)
  htmlSelector           String?
  htmlSelectorType       String?
  htmlSelectorReason     String?
  htmlSelectorConfidence String?
  paginationType         String?
  paginationBtn          String?
  paginationReason       String?
  deletedAt              DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  jobs            Job[]
  scrapeLogs      ScrapeLog[]
  aiLogs          AiLog[]
  aiBatchLogs     AiBatchLog[]
}

model Job {
  id             Int             @id @default(autoincrement())
  companyId      Int
  company        Company         @relation(fields: [companyId], references: [id])
  fingerprint    String          @unique
  title          String
  location       String?
  workMode       String?
  employmentType String?
  roleCategory   String?
  department     String?
  salaryMin      Int?
  salaryMax      Int?
  salaryCurrency String?
  salaryRaw      String?
  description    String?
  deadline       DateTime?
  applyUrl       String?
  status         JobStatus       @default(ACTIVE)
  lastSeenAt     DateTime
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  batchId        String?
  batch          AiBatchLog?     @relation(fields: [batchId], references: [id])

  skills   JobSkill[]
  keywords JobKeyword[]

  @@index([companyId])
  @@index([status])
  @@index([fingerprint])
}

enum SkillType {
  EXPLICIT
  INFERRED
}

model JobSkill {
  id    Int       @id @default(autoincrement())
  jobId Int
  job   Job       @relation(fields: [jobId], references: [id])
  name  String
  type  SkillType

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([jobId])
}

model Keyword {
  id   Int    @id @default(autoincrement())
  name String @unique

  jobs JobKeyword[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JobKeyword {
  jobId         Int
  job           Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  keywordId     Int
  keyword       Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  editedByAdmin Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([jobId, keywordId])
  @@index([jobId])
  @@index([keywordId])
}

enum ScrapeLogTrigger {
  SCHEDULED
  MANUAL
}

enum ScrapeLogStatus {
  SUCCESS
  EMPTY
  SUSPECTED_FAILURE
  ERROR
}

model ScrapeLog {
  id           Int              @id @default(autoincrement())
  companyId    Int
  company      Company          @relation(fields: [companyId], references: [id])
  triggeredBy  ScrapeLogTrigger
  jobsFound    Int              @default(0)
  status       ScrapeLogStatus
  errorMessage String?
  durationMs   Int              @default(0)
  htmlLength   Int?
  type         String
  deletedAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  aiLogs       AiLog[]

  @@index([companyId])
  @@index([createdAt])
}

model AiLog {
  id           String      @id
  companyId    Int
  company      Company     @relation(fields: [companyId], references: [id])
  scrapeLogId  Int
  scrapeLog    ScrapeLog   @relation(fields: [scrapeLogId], references: [id])
  batchId      String?
  batchLog     AiBatchLog? @relation(fields: [batchId], references: [id])
  status       String
  stopReason   String?
  model        String?
  inputTokens  Int?
  outputTokens Int?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([companyId])
  @@index([createdAt])
}

model AiBatchLog {
  id        String    @id
  status    String
  response  Json
  type      String
  aiLogs    AiLog[]
  jobs      Job[]
  companies Company[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([createdAt])
}

model AlertSubscription {
  id        Int      @id @default(autoincrement())
  email     String
  criteria  Json
  confirmed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model AuditLog {
  id          Int        @id @default(autoincrement())
  actorUserId Int?
  actor       AdminUser? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorEmail  String?
  action      String
  entityType  String
  entityId    String?
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  userAgent   String?
  deletedAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

enum PackageType {
  ADSENSE
  MODAL
  SPONSORED_CARD
}

enum InvoiceStatus {
  PENDING
  SENT
  PAID
  OVERDUE
}

model Advertiser {
  id             Int           @id @default(autoincrement())
  name           String
  contactEmail   String
  packageType    PackageType
  slotPosition   Int?
  creativeUrl    String?
  headline       String?
  description    String?
  ctaText        String?
  destinationUrl String?
  startDate      DateTime
  endDate        DateTime
  invoiceStatus  InvoiceStatus @default(PENDING)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([isActive])
  @@index([startDate, endDate])
}

enum SeoPageType {
  ROLE
  LOCATION
  ROLE_LOCATION
  COMPANY
  SKILL
  REMOTE
  INTERNSHIP
}

model SeoPage {
  id               Int         @id @default(autoincrement())
  pageType         SeoPageType
  slug             String      @unique
  roleId           String?
  locationId       String?
  companyId        String?
  skillId          String?
  title            String
  metaDescription  String
  h1               String
  introText        String
  bottomText       String
  canonicalUrl     String
  relatedLinksJson Json
  isIndexable      Boolean
  contentVersion   Int         @default(1)
  lastGeneratedAt  DateTime
  lastReviewedAt   DateTime?
  manualOverride   Boolean     @default(false)
  lastmod          DateTime
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([pageType])
  @@index([slug])
}

model SeoRole {
  id   Int    @id @default(autoincrement())
  name String
  slug String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SeoLocation {
  id      Int    @id @default(autoincrement())
  name    String
  slug    String @unique
  country String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SeoSkill {
  id   Int    @id @default(autoincrement())
  name String
  slug String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

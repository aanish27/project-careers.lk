# App
PORT=8000
NODE_ENV="development"

# Database
DATABASE_URL="postgresql://aanish:axnish1027@localhost:5432/db_careerslk?schema=public"

# CORS
FRONTEND_URL=https://localhost:3000

# JWT
JWT_SECRET="KMyZtwIheb4poU9ByLTRoHalODXysMMFUgyq6CjXAgy"
JWT_ACCESS_TOKEN_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="B4AzxzDkTDH3lMtZzitQ2BFe2HUv2ysmNIQnuSzAj1W"
JWT_REFRESH_TOKEN_EXPIRES_IN="7d"

# JWT — web-user (job-seeker Google-auth accounts). Distinct secrets from the
# admin JWT above are required: see docs/admin-auth-architecture.md context —
# both AdminUser.id and WebUser.id are autoincrement from 1, so sharing a
# secret/strategy would let a web-user token validate as an unrelated admin.
JWT_WEB_USER_SECRET=<generate with: openssl rand -base64 32>
JWT_WEB_USER_ACCESS_TOKEN_EXPIRES_IN="15m"
JWT_WEB_USER_REFRESH_SECRET=<generate with: openssl rand -base64 32>
JWT_WEB_USER_REFRESH_TOKEN_EXPIRES_IN="7d"

# Shared secret with apps/web — required by web-user-auth's InternalOnlyGuard,
# which trusts apps/web's server (and only that caller) to have already
# verified the Google profile it forwards on account creation/login.
INTERNAL_API_KEY=<generate with: openssl rand -base64 32>

# Keys the web-user email-OTP hash (HMAC-SHA256 — not a slow hash; see
# WebUserEmailOtpService for why bcrypt is the wrong tool for a 6-digit code).
OTP_HASH_SECRET=<generate with: openssl rand -base64 32>

# SMTP (email-OTP delivery for web users) — optional, like the AI keys below.
# Leave blank until a provider is chosen; MailService throws a clear error on
# send attempts without these set, rather than failing app startup.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="careers.lk"

# Storage Provider: s3 | local
STORAGE_PROVIDER="s3"
MAX_FILE_SIZE_MB=10

# AWS S3
AWS_REGION="us-southeast-1"
AWS_S3_KEY_ID="your-access-key-id"
AWS_SECRET_S3_KEY="your-secret-access-key"
AWS_S3_BUCKET="your-bucket-name"

# Local Storage (if using local provider)
LOCAL_STORAGE_PATH="./uploads"

REDIS_URL=

# AI cost/usage widgets (all optional — leave unset to show "not configured")
# Admin key (sk-ant-admin01-...), distinct from the scraper's regular API key.
CLAUDE_ADMIN_API_KEY=
CLAUDE_BASE_URL="https://api.anthropic.com"
# Plain REST host, NOT the .../anthropic compatibility host used for scraping.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL="https://api.deepseek.com"

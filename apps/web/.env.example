API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
SESSION_SECRET=<generate with: openssl rand -base64 32>

# Google OAuth (web-user / job-seeker sign-in). Create an OAuth client in
# Google Cloud Console and add GOOGLE_REDIRECT_URI as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Signs the web-user session cookie — deliberately separate from SESSION_SECRET
# (the admin session secret) so a leaked secret's blast radius stays confined
# to one population and one session payload can never be reinterpreted as the other.
WEB_USER_SESSION_SECRET=<generate with: openssl rand -base64 32>

# Shared secret with apps/api — same value as the API's INTERNAL_API_KEY.
# Required so the API's InternalOnlyGuard can trust this server's calls to
# the Google-upsert endpoint.
INTERNAL_API_KEY=<generate with: openssl rand -base64 32>
